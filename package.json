{
  "name": "editordevideos",
  "private": true,
  "version": "1.0.0",
  "description": "Dulos editor - Editor de video profesional de escritorio con WebGL, WebCodecs y aceleración por GPU.",
  "author": "Dulos editor",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "npm run build && electron .",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "build": {
    "appId": "com.duloseditor.desktop",
    "productName": "Dulos editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/bin",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "artifactName": "Dulos-editor-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dulos editor",
      "uninstallDisplayName": "Dulos editor"
    }
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.453.0",
    "mp4-muxer": "^5.1.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
